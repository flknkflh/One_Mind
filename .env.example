# Copy ke .env lalu sesuaikan untuk intranet.
# Mode lokal default: aplikasi langsung melayani HTTPS self-signed.
ONE_MIND_TLS_MODE=internal

# Batasi Host header ke nama/IP yang benar-benar dipakai user.
ONE_MIND_ALLOWED_HOSTS=localhost,127.0.0.1,one-mind.local,192.168.1.20

# Default 12 jam.
ONE_MIND_SESSION_SECONDS=43200

# Default: maksimal 8 login gagal per 10 menit per IP+username.
ONE_MIND_LOGIN_MAX_FAILURES=8
ONE_MIND_LOGIN_WINDOW_SECONDS=600

# Argon2id password hashing. memory 65536 KiB = 64 MiB per verifikasi.
ONE_MIND_ARGON2_TIME_COST=3
ONE_MIND_ARGON2_MEMORY_KIB=65536
ONE_MIND_ARGON2_PARALLELISM=4

# Salin menjadi .env.office. File .env.office tidak boleh masuk Git.
# Gunakan IP statis/reservasi DHCP milik server kantor.
ONE_MIND_BIND_IP=192.168.1.20
ONE_MIND_HTTPS_PORT=8444

# Tanpa skema dan tanpa port. Tambahkan hanya nama/IP yang benar-benar dipakai.
ONE_MIND_ALLOWED_HOSTS=one-mind.office.local,192.168.1.20

# PKI produksi harus diprovisikan secara sadar; jangan dibuat ulang saat startup.
ONE_MIND_PKI_AUTO_INIT=false

# Idle timeout sesi dan proteksi percobaan login.
ONE_MIND_SESSION_SECONDS=300
ONE_MIND_ADMIN_SESSION_SECONDS=300
ONE_MIND_PENDING_LOGIN_SECONDS=300
ONE_MIND_LOGIN_MAX_FAILURES=8
ONE_MIND_LOGIN_WINDOW_SECONDS=600

# Argon2id: 64 MiB per operasi hash/verifikasi dengan nilai default ini.
ONE_MIND_ARGON2_TIME_COST=3
ONE_MIND_ARGON2_MEMORY_KIB=65536
ONE_MIND_ARGON2_PARALLELISM=4

# Batas container; sesuaikan setelah uji beban pada server kantor.
ONE_MIND_CPU_LIMIT=2.0
ONE_MIND_MEMORY_LIMIT=1g

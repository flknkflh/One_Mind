# Domain publik atau domain intranet yang mengarah ke server ini.
ONE_MIND_DOMAIN=drive.example.com

# Email untuk registrasi sertifikat Let's Encrypt via Caddy.
LETSENCRYPT_EMAIL=admin@example.com

# Host header yang diizinkan aplikasi. Untuk produksi, jangan pakai "*".
ONE_MIND_ALLOWED_HOSTS=drive.example.com

# Produksi harus memprovisikan CA secara sengaja. Ubah ke true hanya untuk
# bootstrap awal yang diawasi, lalu kembalikan ke false.
ONE_MIND_PKI_AUTO_INIT=false

# Default 12 jam.
ONE_MIND_SESSION_SECONDS=43200

# Default: maksimal 8 login gagal per 10 menit per IP+username.
ONE_MIND_LOGIN_MAX_FAILURES=8
ONE_MIND_LOGIN_WINDOW_SECONDS=600
